rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 每位使用者只能讀寫自己的存檔：tlps_live_saves/{自己的 uid}
    match /tlps_live_saves/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // （選用）讓指定老師帳號查看全班進度：把信箱換成實際帳號再取消註解
    // match /tlps_live_saves/{uid} {
    //   allow read: if request.auth != null && request.auth.token.email in ['teacher1@tmail.ilc.edu.tw'];
    // }
  }
}
